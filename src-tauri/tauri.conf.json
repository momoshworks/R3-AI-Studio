{
  "$schema": "https://raw.githubusercontent.com/nicepkg/tauri-schema/main/tauri-v2.schema.json",
  "productName": "Ra AI Studio",
  "version": "1.0.0",
  "identifier": "com.nexushub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ra AI Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "center": true
      },
      {
        "label": "notebooklm",
        "title": "Google NotebookLM — Ra AI Studio",
        "url": "https://notebooklm.google.com",
        "width": 1300,
        "height": 850,
        "minWidth": 850,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
